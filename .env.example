# ====== KYRO AI — Configuration serveur (copier vers .env) ======
# Toutes les clés secrètes vivent ICI, jamais dans le navigateur.

# --- Base de données ---
KYRO_DATABASE_URL=postgresql+psycopg://kyro:kyro@localhost:5432/kyro

# --- Sécurité ---
KYRO_JWT_SECRET=changez-moi-avec-une-longue-chaine-aleatoire
KYRO_ENVIRONMENT=production

# ====== IA : fournisseurs ======
# 1) PAR DÉFAUT — aucune clé nécessaire : repli GRATUIT (Pollinations) pour le
#    chat, le code et les images. Débit limité (~1 texte/30 s et ~1 image/45 s
#    par IP) : en cas de dépassement l'API renvoie un message explicite en
#    français et les crédits sont remboursés automatiquement.
#    Les VIDÉOS exigent une clé (voir point 5) — jamais de vidéo simulée.
#    Désactiver le repli : KYRO_FREE_AI=false → 503 tant qu'aucune clé n'existe.
KYRO_FREE_AI=true

# 2) OPTIONNEL — UNE SEULE clé gratuite pour tout (chat + code + images + vidéos)
#    et sans limite de débit : https://enter.pollinations.ai/keys (pollen par quêtes)
# KYRO_POLLINATIONS_KEY=sk_xxxxxxxx

# 3) OPTIONNEL — votre fournisseur de chat/code (compatible OpenAI :
#    OpenAI, Groq, Mistral, DeepSeek, Ollama...). Prioritaire sur le repli.
# KYRO_CHAT_API_BASE=https://api.openai.com/v1
# KYRO_CHAT_API_KEY=sk-xxxxxxxxxxxxxxxx
# KYRO_CHAT_MODEL=gpt-4o-mini

# 4) OPTIONNEL — votre fournisseur d'images (API Images OpenAI, gpt-image-1/dall-e-3).
# KYRO_IMAGE_API_BASE=https://api.openai.com/v1
# KYRO_IMAGE_API_KEY=sk-xxxxxxxxxxxxxxxx
# KYRO_IMAGE_MODEL=gpt-image-1

# 5) VIDÉOS — clé OBLIGATOIRE (aucun service vidéo gratuit sans clé) :
#    a) Replicate (payant) : clé r8_... + modèle owner/name
# KYRO_VIDEO_API_KEY=r8_xxxxxxxxxxxxxxxx
# KYRO_VIDEO_MODEL=minimax/video-01
#    b) Pollinations (pollen gratuit) : clé sk_... — KYRO_VIDEO_MODEL inutile
# KYRO_VIDEO_API_KEY=sk_xxxxxxxx

# --- Divers ---
KYRO_MEDIA_DIR=media
